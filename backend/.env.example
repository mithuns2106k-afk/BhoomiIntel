# BhoomiIntel backend configuration
PORT=5000
FRONTEND_URL=http://localhost:3000
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=
UPLOAD_DIR=

# Live official DILRMP connector cache (10 minutes by default)
LIVE_DATA_CACHE_TTL_MS=600000

# The official DILRMP host may intermittently present a broken TLS certificate.
# Keep false in normal deployments. For a controlled hackathon demo only, set true
# to allow a read-only HTTPS fallback with certificate verification disabled.
DILRMP_ALLOW_INSECURE_TLS=false
